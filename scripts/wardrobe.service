# The dev server of Attire as a systemd user service, so the app is always at
# http://localhost:8081 without anyone typing `npm run serve`.
#
# Install:  ln -sf ~/code/personal/pwa-wardrobe/scripts/wardrobe.service ~/.config/systemd/user/
#           systemctl --user daemon-reload && systemctl --user enable --now wardrobe
# Linger must be on (`loginctl show-user $USER -p Linger`) for it to start with WSL.
[Unit]
Description=Attire dev server (http://localhost:8081)

[Service]
WorkingDirectory=%h/code/personal/pwa-wardrobe
# The same server as `npm run serve`, without npm in between.
ExecStart=/usr/bin/python3 -m http.server 8081
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
