{
  "name": "wardrobe",
  "version": "0.1.2",
  "description": "Wardrobe: load my clothes and generate outfits. Offline Android PWA, plain HTML, CSS and ES modules, no build step",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "imports": {
    "#*": "./src/*.js"
  },
  "scripts": {
    "test": "node --test",
    "serve": "python3 -m http.server 8081",
    "icons": "node scripts/make-icons.mjs",
    "hooks": "git config core.hooksPath .githooks",
    "release": "node scripts/release.mjs",
    "init": "node scripts/init.mjs"
  }
}
